# Database (Defaults to local SQLite for instant testing, or PostgreSQL URL)
DATABASE_URL=sqlite:///./spendleak.db
# Or PostgreSQL: postgresql://user:password@localhost:5432/spendleak

# Environment: development | production
ENVIRONMENT=development

# Gemini API Key (optional for LLM explanations, built-in fallback available)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Auth (optional for JWT verification, demo user mode available)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Default currency
DEFAULT_CURRENCY=INR
